<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <corners android:radius="14dp" />
            <solid android:color="@color/bubnilka_disabled_surface" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="14dp" />
            <solid android:color="@color/bubnilka_chip_pressed" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="14dp" />
            <solid android:color="@color/bubnilka_chip" />
        </shape>
    </item>
</selector>
