<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_title"
            android:textColor="@color/bubnilka_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/cloud_disclosure"
            android:textColor="@color/bubnilka_text"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/cloud_consent_checkbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:text="@string/cloud_consent_checkbox" />

        <TextView
            android:id="@+id/consent_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/consent_required"
            android:textColor="@color/bubnilka_muted" />

        <TextView
            android:id="@+id/permission_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/microphone_not_granted"
            android:textColor="@color/bubnilka_muted" />

        <Button
            android:id="@+id/grant_microphone_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/grant_microphone" />

        <Button
            android:id="@+id/enable_keyboard_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/enable_keyboard" />

        <Button
            android:id="@+id/select_keyboard_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/select_keyboard" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/setup_hint"
            android:textColor="@color/bubnilka_muted" />
    </LinearLayout>
</ScrollView>
