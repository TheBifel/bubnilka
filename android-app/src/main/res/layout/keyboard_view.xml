<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/keyboard_panel"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="32dp">

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            tools:ignore="ButtonStyle">

            <Button
                android:id="@+id/style_structured_button"
                style="@style/BubnilkaStyleChip"
                android:text="@string/style_structured" />

            <Button
                android:id="@+id/style_concise_button"
                style="@style/BubnilkaStyleChip"
                android:text="@string/style_concise" />

            <Button
                android:id="@+id/style_professional_button"
                style="@style/BubnilkaStyleChip"
                android:text="@string/style_professional" />

            <Button
                android:id="@+id/style_friendly_button"
                style="@style/BubnilkaStyleChip"
                android:text="@string/style_friendly" />

            <Button
                android:id="@+id/style_viking_button"
                style="@style/BubnilkaStyleChip"
                android:layout_marginEnd="0dp"
                android:text="@string/style_viking" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/keyboard_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="7dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/status_ready"
        android:textColor="@color/bubnilka_muted"
        android:textSize="12sp" />

    <ScrollView
        android:id="@+id/transcript_scroll"
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/transcript_panel"
        android:fadeScrollbars="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbarStyle="insideInset"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/transcript_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="78dp"
            android:paddingStart="14dp"
            android:paddingTop="9dp"
            android:paddingEnd="18dp"
            android:paddingBottom="9dp"
            android:text="@string/transcript_placeholder"
            android:textColor="@color/bubnilka_text"
            android:textSize="15sp" />
    </ScrollView>

    <FrameLayout
        android:id="@+id/primary_actions"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:foregroundGravity="center_vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start|center_vertical"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/switch_keyboard_button"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/utility_button"
                android:contentDescription="@string/switch_keyboard"
                android:padding="13dp"
                android:src="@drawable/ic_keyboard" />

            <ImageButton
                android:id="@+id/language_settings_button"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/utility_button"
                android:contentDescription="@string/language_settings"
                android:padding="13dp"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <com.thebifel.bubnilka.ime.VoiceRippleView
            android:id="@+id/microphone_ripple"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no" />

        <ImageButton
            android:id="@+id/microphone_button"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:background="@drawable/microphone_button"
            android:contentDescription="@string/start_dictation"
            android:padding="18dp"
            android:src="@drawable/ic_mic" />

        <ImageButton
            android:id="@+id/backspace_button"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/utility_button"
            android:contentDescription="@string/backspace"
            android:padding="13dp"
            android:src="@drawable/ic_backspace" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/recovery_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:ignore="ButtonStyle">

        <Button
            android:id="@+id/retry_button"
            style="@style/BubnilkaSecondaryButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/retry" />

        <Button
            android:id="@+id/insert_raw_button"
            style="@style/BubnilkaSecondaryButton"
            android:layout_width="0dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/insert_raw" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/post_insert_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:ignore="ButtonStyle">

        <Button
            android:id="@+id/undo_button"
            style="@style/BubnilkaSecondaryButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/undo" />

        <Button
            android:id="@+id/regenerate_button"
            style="@style/BubnilkaSecondaryButton"
            android:layout_width="0dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/regenerate" />
    </LinearLayout>
</LinearLayout>
