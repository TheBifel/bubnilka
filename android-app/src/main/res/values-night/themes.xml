<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Bubnilka" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/bubnilka_primary</item>
        <item name="android:navigationBarColor">@color/bubnilka_background</item>
        <item name="android:windowLightNavigationBar">@bool/bubnilka_light_system_bars</item>
        <item name="android:windowLightStatusBar">@bool/bubnilka_light_system_bars</item>
        <item name="android:windowBackground">@color/bubnilka_background</item>
    </style>

    <style name="Theme.Bubnilka.Popup" parent="android:style/Theme.Material">
        <item name="android:colorAccent">@color/bubnilka_primary</item>
        <item name="android:colorBackground">@color/bubnilka_surface</item>
        <item name="android:textColorPrimary">@color/bubnilka_text</item>
    </style>
</resources>
