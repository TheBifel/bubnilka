<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Bubnilka" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/bubnilka_primary</item>
        <item name="android:navigationBarColor">@color/bubnilka_background</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/bubnilka_background</item>
    </style>

    <style name="BubnilkaStyleChip" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:background">@drawable/style_chip</item>
        <item name="android:elevation">0dp</item>
        <item name="android:fontFamily">sans-medium</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/style_chip_text</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="BubnilkaSecondaryButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_height">42dp</item>
        <item name="android:background">@drawable/secondary_button</item>
        <item name="android:elevation">0dp</item>
        <item name="android:fontFamily">sans-medium</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/bubnilka_text</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
